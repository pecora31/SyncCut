{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncCut",
  "version": "0.2.3",
  "identifier": "com.synccut.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncCut - AI Video Aligner & Premiere XML Generator",
        "width": 1400,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "maximized": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "../bin/yt-dlp.exe": "bin/yt-dlp.exe",
      "../bin/ffmpeg.exe": "bin/ffmpeg.exe",
      "../bin/ffprobe.exe": "bin/ffprobe.exe",
      "../engine/synccut_engine/": "engine/synccut_engine/",
      "../engine/tests/": "engine/tests/",
      "../engine/models.json": "engine/models.json",
      "../engine/launch_worker.py": "engine/launch_worker.py",
      "../engine/requirements.txt": "engine/requirements.txt",
      "../engine/setup-runtime.ps1": "engine/setup-runtime.ps1",
      "../engine/manage_models.py": "engine/manage_models.py",
      "../engine/preflight.py": "engine/preflight.py",
      "../engine/customer-check.ps1": "engine/customer-check.ps1",
      "../engine/monitor_resources.py": "engine/monitor_resources.py",
      "../runtime/README.md": "runtime/README.md",
      "../runtime/FFmpeg-NOTICE.md": "runtime/FFmpeg-NOTICE.md",
      "../docs/customer-validation.md": "docs/customer-validation.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFDMzQ1Q0Y2MkY0RTZCOTEKUldTUmEwNHY5bHcwSEsvTWRXT25HeHNlSnkwOEdlb3FWcElzSG9YUXlpL1Z3RXFWSldPZ092NmEK",
      "endpoints": ["https://github.com/pecora31/SyncCut/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
